{
  "name": "dsh-advanced-mem-plugin",
  "version": "0.3.0",
  "description": "Factual and experience memory for DeepSeek Harness, with outcome-grounded skills, lifecycle management and API benchmark adapters",
  "keywords": [
    "deepseek-harness",
    "dsh-bundle",
    "dsh-plugin",
    "cordis",
    "agent-memory",
    "knowledge-graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CenYangtze/dsh-advanced-mem-plugin.git"
  },
  "type": "module",
  "main": "lib/memory/index.js",
  "types": "lib/memory/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/memory/index.d.ts",
      "default": "./lib/memory/index.js"
    },
    "./invariant": {
      "types": "./lib/memory/invariant.d.ts",
      "default": "./lib/memory/invariant.js"
    },
    "./store-domain": {
      "types": "./lib/memory-store-domain/index.d.ts",
      "default": "./lib/memory-store-domain/index.js"
    },
    "./embedding-hash": {
      "types": "./lib/memory-embedding-hash/index.d.ts",
      "default": "./lib/memory-embedding-hash/index.js"
    },
    "./observer": {
      "types": "./lib/memory-observer/index.d.ts",
      "default": "./lib/memory-observer/index.js"
    },
    "./consolidation": {
      "types": "./lib/memory-consolidation/index.d.ts",
      "default": "./lib/memory-consolidation/index.js"
    },
    "./recall": {
      "types": "./lib/memory-recall/index.d.ts",
      "default": "./lib/memory-recall/index.js"
    },
    "./tool": {
      "types": "./lib/tool-memory/index.d.ts",
      "default": "./lib/tool-memory/index.js"
    },
    "./command": {
      "types": "./lib/command-memory/index.d.ts",
      "default": "./lib/command-memory/index.js"
    },
    "./experience": {
      "types": "./lib/experience/index.d.ts",
      "default": "./lib/experience/index.js"
    },
    "./experience/api": {
      "types": "./lib/experience/api.d.ts",
      "default": "./lib/experience/api.js"
    },
    "./experience-store-domain": {
      "types": "./lib/experience-store-domain/index.d.ts",
      "default": "./lib/experience-store-domain/index.js"
    },
    "./experience-harness": {
      "types": "./lib/experience-harness/index.d.ts",
      "default": "./lib/experience-harness/index.js"
    },
    "./evaluation": {
      "types": "./lib/evaluation/index.d.ts",
      "default": "./lib/evaluation/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/experience-harness/client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/**/*.md",
    "src/evaluation/*.py",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.ts",
    "prepare": "tsdown && tsdown --config tsdown.client.config.ts",
    "verify": "node scripts/verify-bundle.mjs",
    "link-harness": "node scripts/link-harness.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --experimental-transform-types bench/run.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-default-model": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@types/react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
